---
import DetailAdjacentNavigation from "@/components/ui/detail/DetailAdjacentNavigation.astro";
import DetailBack from "@/components/ui/detail/DetailBack.astro";
import DetailDescription from "@/components/ui/detail/DetailDescription.astro";
import DetailExperienceTimeline from "@/components/ui/detail/DetailExperienceTimeline.astro";
import DetailImage from "@/components/ui/detail/DetailImage.astro";
import DetailMonoLabel from "@/components/ui/detail/DetailMonoLabel.astro";
import DetailTitle from "@/components/ui/detail/DetailTitle.astro";
import Divider from "@/components/ui/Divider.astro";
import CustomPortableText from "@/components/ui/portable-text/CustomPortableText.astro";
import {
  allExperiencesQuery,
  experienceDetailQuery,
  sanityClient,
} from "@/lib/query";
import LayoutBase from "@/layouts/LayoutBase.astro";
import type {
  AllExperiencesQueryResult,
  ExperienceDetailQueryResult,
} from "@/types/sanity";

interface AdjacentExperience {
  description: string;
  href: string;
  title: string;
}

export const getStaticPaths = async () => {
  const allExperiences =
    await sanityClient.fetch<AllExperiencesQueryResult>(allExperiencesQuery);

  const orderedExperiences = allExperiences.map((experience) => ({
    description: experience.companySummary,
    href: `/experiences/${experience.slug.current}`,
    slug: experience.slug.current,
    title: experience.company,
  }));

  return orderedExperiences.map((experience, index) => ({
    props: {
      next: orderedExperiences[index + 1],
      previous: orderedExperiences[index - 1],
    },
    params: {
      slug: experience.slug,
    },
  }));
};

const experienceDetailData =
  await sanityClient.fetch<ExperienceDetailQueryResult>(experienceDetailQuery, {
    slug: Astro.params.slug,
  });

if (!experienceDetailData) {
  throw new Error("Experience data not found");
}

const { next, previous } = Astro.props as {
  next?: AdjacentExperience;
  previous?: AdjacentExperience;
};

const rolesSectionLabel =
  experienceDetailData.roles.length === 1 ? "Role" : "Roles";
---

<LayoutBase
  title={`${experienceDetailData.company} Experience | Dewantoro Triatmojo`}
  description={experienceDetailData.companySummary}
  linkPreviewImage={experienceDetailData.image}
>
  <main class="flex flex-auto justify-center px-5 py-10 sm:p-12 lg:p-14">
    <div class="flex w-full max-w-xl flex-col gap-6 lg:max-w-3xl lg:gap-8">
      <div class="animate-fade-in-up" style="animation-delay: 0.05s;">
        <DetailBack href="/experiences" label="Back to Experiences" />
      </div>

      <article class="flex flex-col gap-6 lg:gap-8">
        <div
          class="border-border bg-muted animate-fade-in-scale relative overflow-hidden rounded-xl border"
          style="animation-delay: 0.1s;"
        >
          <DetailImage
            src={experienceDetailData.image.url!}
            alt={experienceDetailData.image.alt}
          />
          <div
            class="from-background/40 pointer-events-none absolute inset-0 bg-linear-to-t via-transparent to-transparent"
          >
          </div>
        </div>

        <header class="flex flex-col">
          <div class="animate-fade-in-up" style="animation-delay: 0.15s;">
            <DetailMonoLabel
              >{experienceDetailData.detailMonoLabel}</DetailMonoLabel
            >
          </div>

          <div
            class="animate-fade-in-up mt-1 lg:mt-2"
            style="animation-delay: 0.2s;"
          >
            <DetailTitle>{experienceDetailData.company}</DetailTitle>
          </div>

          <div
            class="animate-fade-in-up mt-2 lg:mt-3"
            style="animation-delay: 0.25s;"
          >
            <DetailDescription>
              {experienceDetailData.companySummary}
            </DetailDescription>
          </div>
        </header>

        <section
          class="animate-fade-in-up -mt-2 flex flex-col gap-4 lg:-mt-3"
          style="animation-delay: 0.3s;"
        >
          <h2
            class="text-muted-foreground/80 font-mono text-xs tracking-widest uppercase lg:text-sm"
          >
            {rolesSectionLabel}
          </h2>
          <DetailExperienceTimeline roles={experienceDetailData.roles} />
        </section>

        <div class="animate-fade-in-up" style="animation-delay: 0.35s;">
          <Divider />
        </div>

        <section
          class="animate-fade-in-up w-full"
          style="animation-delay: 0.4s;"
        >
          {
            (
              // @ts-ignore
              <CustomPortableText value={experienceDetailData.content} />
            )
          }
        </section>

        <div class="animate-fade-in-up" style="animation-delay: 0.45s;">
          <Divider />
        </div>

        <div class="animate-fade-in-up" style="animation-delay: 0.5s;">
          <DetailAdjacentNavigation previous={previous} next={next} />
        </div>
      </article>
    </div>
  </main>
</LayoutBase>
