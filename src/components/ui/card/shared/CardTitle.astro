---
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";

interface Props {
  as?: "h2" | "h3";
  showArrow?: boolean;
  arrowHover?: "card" | "section";
  class?: string;
}

const {
  as: Tag = "h2",
  showArrow = true,
  arrowHover = "card",
  class: className,
} = Astro.props as Props;

const titleHoverClass =
  "text-foreground transition-colors duration-200 group-hover/card:text-primary";

const arrowHoverClasses = {
  card: "text-primary size-4 shrink-0 -translate-x-1 opacity-0 transition-all duration-200 group-hover/card:translate-x-0 group-hover/card:opacity-100",
  section:
    "text-primary size-4 shrink-0 -translate-x-1 opacity-0 transition-all duration-200 group-hover/section:translate-x-0 group-hover/section:opacity-100",
} as const;

const arrowHoverClass = arrowHoverClasses[arrowHover];
---

<div class:list={["flex items-center gap-2", className]}>
  <Tag
    class:list={[
      "text-lg font-bold lg:text-xl",
      showArrow ? titleHoverClass : "text-foreground",
    ]}
  >
    <slot />
  </Tag>
  {showArrow && <ArrowRightIcon class={arrowHoverClass} />}
</div>
